generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums (mirrored in packages/shared/src/enums — keep both in sync) ---

enum StaffRole {
  STAFF
  MLA
  SUPER_ADMIN
}

enum ComplaintStatus {
  RECEIVED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum ImageType {
  CITIZEN_UPLOAD
  STAFF_WORK_PHOTO
}

enum AnnouncementType {
  DEVELOPMENT_PROJECT
  EMERGENCY_NOTICE
  GOVT_SCHEME
  EVENT
  BLOOD_DONATION
  HEALTH_CAMP
  EMPLOYMENT_NEWS
}

enum PartyStatus {
  PARTY
  INDEPENDENT
}

enum CampaignPostType {
  POSTER
  VIDEO
  ANNOUNCEMENT
  WORK_UPDATE
  PUBLIC_MESSAGE
}

enum CampaignEventType {
  PUBLIC_MEETING
  RALLY
  PROGRAM
}

enum PostMediaType {
  NONE
  IMAGE
  VIDEO
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReactionType {
  LIKE
  SUPPORT
  APPRECIATED
  WOW
  CONCERN
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS_ONLY
  PRIVATE
}

enum ReportReason {
  SPAM
  FAKE_INFORMATION
  ABUSE
  HATE_HARASSMENT
  INAPPROPRIATE_CONTENT
  VIOLENCE
  OTHER
}

enum DevProjectCategory {
  ROAD
  SCHOOL
  HOSPITAL
  WATER
  PARK
  OTHER
}

enum DevProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
}

enum EmergencyContactCategory {
  POLICE
  FIRE
  AMBULANCE
  WATER_DEPT
  ELECTRICITY_DEPT
  MLA_OFFICE
  OTHER
}

enum NotificationType {
  STATUS_CHANGE
  ANNOUNCEMENT
  EMERGENCY
  MEETING
  CAMPAIGN_POST
  CAMPAIGN_EVENT
  NEW_POST
  POST_LIKE
  POST_COMMENT
  COMMENT_REPLY
  NEW_FOLLOWER
  POST_SHARE
  REPORT_UPDATE
  WARNING
}

enum RecipientType {
  CITIZEN
  STAFF
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
}

// Generic owner/actor discriminator used by auth + audit tables, since citizens and
// staff live in two separate tables (different auth mechanisms — see build plan).
enum OwnerType {
  CITIZEN
  STAFF
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum AppointmentStatus {
  PENDING
  SCHEDULED
  REJECTED
  COMPLETED
  CANCELLED
}

// --- Lookup tables ---

model Ward {
  id         String   @id @default(uuid())
  wardNumber Int      @unique
  name       String
  city       String
  createdAt  DateTime @default(now())

  citizens            Citizen[]
  complaints          Complaint[]
  staffAssignments    StaffWardAssignment[]
  developmentProjects DevelopmentProject[]
}

model Department {
  id         String     @id @default(uuid())
  name       String     @unique
  createdAt  DateTime   @default(now())
  categories Category[]
}

model Category {
  id           String     @id @default(uuid())
  name         String     @unique
  icon         String?
  isActive     Boolean    @default(true)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now())

  complaints       Complaint[]
  staffAssignments StaffCategoryAssignment[]
}

// --- People ---

model Citizen {
  id              String   @id @default(uuid())
  name            String
  phone           String   @unique
  address         String?
  wardId          String?
  ward            Ward?    @relation(fields: [wardId], references: [id])
  city            String?
  pincode         String?
  isBlocked       Boolean  @default(false)
  isVerified      Boolean  @default(false)
  verifiedLabel   String?
  bio             String?
  profilePhotoUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  complaints             Complaint[]
  feedbacks              Feedback[]
  appointments           Appointment[]
  campaignPostLikes      CampaignPostLike[]
  campaignEventInterests CampaignEventInterest[]
  campaignFeedbacks      CampaignFeedback[]
  posts                  Post[]
  postLikes              PostLike[]
  postComments           PostComment[]
  postReports            PostReport[]
  verificationRequests   VerificationRequest[]
  followers              Follow[]                @relation("Following")
  following              Follow[]                @relation("Follower")
  commentLikes           CommentLike[]
  commentReports         CommentReport[]
  visiblePosts           PostVisibleTo[]
  warnings               UserWarning[]
  pollVotes              PollVote[]
  linkedStaff            StaffMember?
  posterGenerations      PosterGeneration[]
}

model StaffMember {
  id              String    @id @default(uuid())
  name            String
  username        String    @unique
  email           String?   @unique
  passwordHash    String
  role            StaffRole @default(STAFF)
  phone           String?
  designation     String?
  isActive        Boolean   @default(true)
  linkedCitizenId String?   @unique
  linkedCitizen   Citizen?  @relation(fields: [linkedCitizenId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  wardAssignments               StaffWardAssignment[]
  categoryAssignments           StaffCategoryAssignment[]
  assignedComplaints            Complaint[]               @relation("AssignedStaff")
  createdAnnouncements          Announcement[]
  createdCandidateAnnouncements CandidateAnnouncement[]
  createdCampaignPosts          CampaignPost[]
  createdCampaignEvents         CampaignEvent[]
  reviewedVerifications         VerificationRequest[]
  issuedWarnings                UserWarning[]
  createdPosterTemplates        PosterTemplate[]
}

model StaffWardAssignment {
  staffId String
  wardId  String
  staff   StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  ward    Ward        @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@id([staffId, wardId])
}

model StaffCategoryAssignment {
  staffId    String
  categoryId String
  staff      StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([staffId, categoryId])
}

// --- Auth ---

model OtpVerification {
  id         String     @id @default(uuid())
  phone      String
  otpHash    String
  purpose    OtpPurpose
  expiresAt  DateTime
  attempts   Int        @default(0)
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone])
}

model RefreshToken {
  id        String    @id @default(uuid())
  ownerType OwnerType
  ownerId   String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerType, ownerId])
}

model DeviceToken {
  id        String         @id @default(uuid())
  ownerType OwnerType
  ownerId   String
  token     String         @unique
  platform  DevicePlatform
  createdAt DateTime       @default(now())

  @@index([ownerType, ownerId])
}

// --- Complaints (core workflow) ---

model Complaint {
  id              String            @id @default(uuid())
  complaintNumber String            @unique
  citizenId       String
  citizen         Citizen           @relation(fields: [citizenId], references: [id])
  title           String
  description     String
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id])
  priority        ComplaintPriority @default(MEDIUM)
  status          ComplaintStatus   @default(RECEIVED)
  wardId          String
  ward            Ward              @relation(fields: [wardId], references: [id])
  address         String
  latitude        Float?
  longitude       Float?
  contactNumber   String
  assignedStaffId String?
  assignedStaff   StaffMember?      @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  assignedAt      DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  images        ComplaintImage[]
  statusHistory ComplaintStatusHistory[]
  feedback      Feedback?

  @@index([citizenId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([wardId])
  @@index([categoryId])
}

model ComplaintImage {
  id             String    @id @default(uuid())
  complaintId    String
  complaint      Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  url            String
  type           ImageType
  uploadedByType OwnerType
  uploadedById   String
  createdAt      DateTime  @default(now())

  @@index([complaintId])
}

// Full transition log — powers the required complaint Timeline and the
// "notify citizen on every status change" behavior. Current status still
// lives as a column on Complaint for fast filtering/queries.
model ComplaintStatusHistory {
  id            String           @id @default(uuid())
  complaintId   String
  complaint     Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fromStatus    ComplaintStatus?
  toStatus      ComplaintStatus
  remarks       String?
  changedByType OwnerType
  changedById   String
  createdAt     DateTime         @default(now())

  @@index([complaintId])
}

// Citizen requests a meeting with the MLA; staff/admin schedules or rejects it.
// Kept single-status (no history table, unlike Complaint) since there's no
// requirement for a full audit timeline here.
model Appointment {
  id            String            @id @default(uuid())
  citizenId     String
  citizen       Citizen           @relation(fields: [citizenId], references: [id])
  purpose       String
  preferredDate DateTime
  contactNumber String
  status        AppointmentStatus @default(PENDING)
  scheduledAt   DateTime?
  remarks       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([citizenId])
  @@index([status])
}

model Feedback {
  id          String    @id @default(uuid())
  complaintId String    @unique
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  citizenId   String
  citizen     Citizen   @relation(fields: [citizenId], references: [id])
  rating      Int
  comment     String?
  satisfied   Boolean
  createdAt   DateTime  @default(now())
}

// --- Content ---

model Announcement {
  id          String           @id @default(uuid())
  title       String
  body        String
  type        AnnouncementType
  imageUrl    String?
  publishAt   DateTime         @default(now())
  isPublished Boolean          @default(true)
  createdById String
  createdBy   StaffMember      @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  @@index([isPublished, publishAt])
}

model DevelopmentProject {
  id             String             @id @default(uuid())
  title          String
  category       DevProjectCategory
  description    String
  budget         Decimal?           @db.Decimal(14, 2)
  wardId         String
  ward           Ward               @relation(fields: [wardId], references: [id])
  status         DevProjectStatus   @default(PLANNED)
  startDate      DateTime?
  completionDate DateTime?
  createdAt      DateTime           @default(now())

  gallery Gallery[]
}

model Gallery {
  id        String             @id @default(uuid())
  projectId String
  project   DevelopmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  order     Int                @default(0)
}

model WelfareScheme {
  id          String   @id @default(uuid())
  title       String
  description String
  eligibility String
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([isActive])
}

model EmergencyContact {
  id       String                   @id @default(uuid())
  name     String
  category EmergencyContactCategory
  phone    String
  order    Int                      @default(0)
  isActive Boolean                  @default(true)
}

model Notification {
  id                     String           @id @default(uuid())
  recipientType          RecipientType
  recipientId            String
  title                  String
  body                   String
  type                   NotificationType
  relatedComplaintId     String?
  relatedAnnouncementId  String?
  relatedAppointmentId   String?
  relatedCampaignPostId  String?
  relatedCampaignEventId String?
  relatedPostId          String?
  isRead                 Boolean          @default(false)
  pushStatus             String?
  createdAt              DateTime         @default(now())

  @@index([recipientType, recipientId])
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id         String    @id @default(uuid())
  actorType  OwnerType
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([actorType, actorId])
}

// --- Election Campaign & Promotion ---

model CandidateAnnouncement {
  id              String      @id @default(uuid())
  candidateName   String
  profileImageUrl String?
  position        String
  constituency    String
  partyStatus     PartyStatus @default(PARTY)
  partyName       String?
  message         String
  publishAt       DateTime    @default(now())
  isPublished     Boolean     @default(true)
  createdById     String
  createdBy       StaffMember @relation(fields: [createdById], references: [id])
  createdAt       DateTime    @default(now())

  @@index([isPublished, publishAt])
}

model CampaignPost {
  id          String           @id @default(uuid())
  type        CampaignPostType
  title       String
  description String?
  mediaUrl    String?
  publishAt   DateTime         @default(now())
  isPublished Boolean          @default(true)
  createdById String
  createdBy   StaffMember      @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  likes CampaignPostLike[]

  @@index([isPublished, publishAt])
}

model CampaignEvent {
  id          String            @id @default(uuid())
  title       String
  type        CampaignEventType
  eventDate   DateTime
  location    String
  details     String?
  isActive    Boolean           @default(true)
  createdById String
  createdBy   StaffMember       @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  interests CampaignEventInterest[]

  @@index([isActive, eventDate])
}

model CampaignPostLike {
  id        String       @id @default(uuid())
  postId    String
  post      CampaignPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  citizenId String
  citizen   Citizen      @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([postId, citizenId])
}

model CampaignEventInterest {
  id        String        @id @default(uuid())
  eventId   String
  event     CampaignEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  citizenId String
  citizen   Citizen       @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([eventId, citizenId])
}

model CampaignFeedback {
  id        String   @id @default(uuid())
  citizenId String
  citizen   Citizen  @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// --- Citizen Connect Feed (social feed module) ---

model Post {
  id           String         @id @default(uuid())
  authorId     String
  author       Citizen        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content      String
  mediaType    PostMediaType  @default(NONE)
  mediaUrl     String?
  visibility   PostVisibility @default(PUBLIC)
  isPinned     Boolean        @default(false)
  isFeatured   Boolean        @default(false)
  isHidden     Boolean        @default(false)
  sharedPostId String?
  sharedPost   Post?          @relation("PostShares", fields: [sharedPostId], references: [id], onDelete: SetNull)
  shares       Post[]         @relation("PostShares")
  locationTag  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  likes     PostLike[]
  comments  PostComment[]
  reports   PostReport[]
  hashtags  Hashtag[]
  visibleTo PostVisibleTo[]
  poll      Poll?

  @@index([isHidden, createdAt])
  @@index([authorId])
}

model Poll {
  id        String   @id @default(uuid())
  postId    String   @unique
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  question  String
  createdAt DateTime @default(now())

  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     String @id @default(uuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label  String
  order  Int    @default(0)

  votes PollVote[]
}

model PollVote {
  id        String     @id @default(uuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  citizenId String
  citizen   Citizen    @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([pollId, citizenId])
}

model PostVisibleTo {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  citizenId String
  citizen   Citizen  @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, citizenId])
}

model Hashtag {
  id        String   @id @default(uuid())
  tag       String   @unique
  createdAt DateTime @default(now())

  posts Post[]
}

model PostLike {
  id        String       @id @default(uuid())
  postId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  citizenId String
  citizen   Citizen      @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  @@unique([postId, citizenId])
}

model PostComment {
  id              String        @id @default(uuid())
  postId          String
  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  citizenId       String
  citizen         Citizen       @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  content         String
  parentCommentId String?
  parentComment   PostComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         PostComment[] @relation("CommentReplies")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  likes   CommentLike[]
  reports CommentReport[]

  @@index([postId])
}

model CommentLike {
  id        String      @id @default(uuid())
  commentId String
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  citizenId String
  citizen   Citizen     @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([commentId, citizenId])
}

model CommentReport {
  id         String       @id @default(uuid())
  commentId  String
  comment    PostComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   Citizen      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reasonType ReportReason @default(OTHER)
  details    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@index([status])
}

model PostReport {
  id         String       @id @default(uuid())
  postId     String
  post       Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   Citizen      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reasonType ReportReason @default(OTHER)
  details    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@index([status])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    Citizen  @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   Citizen  @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model VerificationRequest {
  id             String             @id @default(uuid())
  citizenId      String
  citizen        Citizen            @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  requestedLabel String
  status         VerificationStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     StaffMember?       @relation(fields: [reviewedById], references: [id])
  createdAt      DateTime           @default(now())
}

model UserWarning {
  id         String      @id @default(uuid())
  citizenId  String
  citizen    Citizen     @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  reason     String
  issuedById String
  issuedBy   StaffMember @relation(fields: [issuedById], references: [id])
  createdAt  DateTime    @default(now())

  @@index([citizenId])
}

// --- Personalized campaign posters ---

model PosterTemplate {
  id          String  @id @default(uuid())
  name        String
  category    String?
  imageUrl    String
  imageWidth  Int
  imageHeight Int

  // Selfie placement — relative (0-1) coordinates of the shape's CENTER, and its
  // size (diameter, or side length for square/rounded) as a fraction of the template
  // width, so one definition works at any output resolution the template image is
  // later re-encoded at.
  selfieX     Float
  selfieY     Float
  selfieSize  Float
  selfieShape String @default("circle")

  // Name text placement — relative (0-1) coordinates of the text's center point.
  nameX        Float
  nameY        Float
  nameFontSize Int    @default(32)
  nameColor    String @default("#FFFFFF")
  nameAlign    String @default("center")
  nameMaxWidth Float?

  isActive    Boolean     @default(true)
  createdById String
  createdBy   StaffMember @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  generations PosterGeneration[]

  @@index([isActive])
}

model PosterGeneration {
  id              String         @id @default(uuid())
  templateId      String
  template        PosterTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  citizenId       String
  citizen         Citizen        @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  name            String
  resultUrl       String
  publishedPostId String?
  createdAt       DateTime       @default(now())

  @@index([templateId])
  @@index([citizenId])
}
