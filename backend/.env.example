# Copy to .env and fill in for local dev. Safe defaults below run entirely locally.

NODE_ENV=development
# Default 4100 (not 4000) to avoid clashing with other local services commonly bound to 4000.
PORT=4100

# postgresql://<user>:<password>@localhost:5432/<db>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/citizen_connect?schema=public"

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# console (default, logs OTP to server stdout + echoes it in API response outside production) | twilio | msg91
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# local (default, serves from /uploads) | s3 | cloudinary
STORAGE_PROVIDER=local
# AWS_S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# console (default, logs push payloads) | expo
PUSH_PROVIDER=console

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!

# Set this to your machine's LAN IP (e.g. http://192.168.1.5:4100) when testing the mobile
# app on a physical device via Expo Go — "localhost" from the phone means the phone itself.
# PUBLIC_URL=http://localhost:4100
